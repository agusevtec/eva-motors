    <briefdescription>
<para>Driver for the TB6612FNG dual H-bridge motor driver. </para>
    </briefdescription>
    <detaileddescription>
<para>Pin connection:<itemizedlist>
<listitem><para>PWMA - speed control PWM pin</para>
</listitem><listitem><para>AIN1 / AIN2 - direction control pins for motor A</para>
</listitem><listitem><para>PWMB, BIN1, BIN2 for motor B (use separate instance)</para>
</listitem></itemizedlist>
</para>
<para><parameterlist kind="templateparam"><parameteritem>
<parameternamelist>
<parametername>tPinSpeed</parametername>
</parameternamelist>
<parameterdescription>
<para>PWM pin for speed control </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>tPinMode1</parametername>
</parameternamelist>
<parameterdescription>
<para>Direction pin 1 (IN1) </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>tPinMode2</parametername>
</parameternamelist>
<parameterdescription>
<para>Direction pin 2 (IN2) </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
    </detaileddescription>
