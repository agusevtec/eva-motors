    <briefdescription>
<para>Bidirectional motor controller (forward/reverse). </para>
    </briefdescription>
    <detaileddescription>
<para>Maps a signed input range -1000..1000 to driver-specific output values. Negative values correspond to reverse, positive to forward.</para>
<para><parameterlist kind="templateparam"><parameteritem>
<parameternamelist>
<parametername>TDriver</parametername>
</parameternamelist>
<parameterdescription>
<para>TDriver class (must implement actBipolar(signed short)) </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>tMaxBackward</parametername>
</parameternamelist>
<parameterdescription>
<para>Maximum reverse output value (e.g., -1000) </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>tMinBackward</parametername>
</parameternamelist>
<parameterdescription>
<para>Minimum reverse output value (e.g., -50) </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>tMinForward</parametername>
</parameternamelist>
<parameterdescription>
<para>Minimum forward output value (e.g., 50) </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>tMaxForward</parametername>
</parameternamelist>
<parameterdescription>
<para>Maximum forward output value (e.g., 1000) </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
    </detaileddescription>
